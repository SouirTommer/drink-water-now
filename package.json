{
  "name": "drink-water",
  "displayName": "Drink Water Reminder",
  "description": "💧 Hydration & caffeine break reminder — status bar only, no modals.",
  "version": "0.0.1",
  "publisher": "demo",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "drinkWater.dismiss",
        "title": "%drinkWater.dismiss.title%"
      },
      {
        "command": "drinkWater.remindNow",
        "title": "%drinkWater.remindNow.title%"
      }
    ],
    "configuration": {
      "title": "Drink Water",
      "properties": {
        "drinkWater.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%drinkWater.enabled.description%"
        },
        "drinkWater.intervalMinutes": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "description": "%drinkWater.intervalMinutes.description%"
        },
        "drinkWater.language": {
          "type": "string",
          "enum": ["auto", "en", "zh-tw", "zh-cn"],
          "default": "auto",
          "description": "%drinkWater.language.description%"
        },
        "drinkWater.messages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%drinkWater.messages.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.125.0",
    "typescript": "^5.9.3"
  }
}
